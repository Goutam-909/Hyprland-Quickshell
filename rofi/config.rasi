/**
 * Ani-CLI Rofi Theme
 * A sleek anime-themed interface with Matugen colors
 */

@import "~/.config/rofi/colors/matugen.rasi"


* {
	bg-col:  @background;
	bg-col-light: @background-alt;
	border-col: @primary;
	selected-col: @secondary-container;
	blue: @primary;
	fg-col: @foreground;
	fg-col2: @secondary;
	grey: @foreground-alt;
	pink: @tertiary;
	green: @secondary-container;
	accent: @primary-container;
	width: 900;
}

element-text, element-icon , mode-switcher {
	background-color: inherit;
	text-color:       inherit;
}

window {
	transparency:                "real";
	height: 600px;
	border: 3px;
	border-color: @border-col;
	background-color: black / 10%;
	border-radius: 16px;
}

mainbox {
	background-color: transparent;
	padding: 12px;
}

inputbar {
	children: [prompt,entry];
	background-color: transparent;
	border-radius: 12px;
	padding: 8px;
}

prompt {
	background-color: @blue;
	padding: 10px 16px;
	text-color: @primary-fg;
	border-radius: 12px;
	margin: 0px 10px 0px 0px;
	font: "JetBrains Mono Bold 11";
}

textbox-prompt-colon {
	expand: false;
	str: ":";
}

entry {
	padding: 10px 12px;
	text-color: @fg-col;
	background-color: @bg-col-light;
	placeholder: "Search anime...";
	placeholder-color: @grey;
	border-radius: 12px;
}

listview {
	border: 0px 0px 0px;
	padding: 6px 0px 0px;
	margin: 10px 0px 0px 0px;
	columns: 1;
	lines: 8;
	background-color: transparent;
	spacing: 6px;
}

element {
	padding: 12px;
	background-color: @bg-col;
	text-color: @fg-col;
	border-radius: 12px;
	border: 2px;
	border-color: transparent;
}

element-icon {
	size: 28px;
	margin: 0px 10px 0px 0px;
}

element selected {
	background-color: @selected-col;
	text-color: @secondary-fg;
	border-color: @primary;
}

element normal.normal {
	background-color: @bg-col;
	text-color: @fg-col;
}

element alternate.normal {
	background-color: @bg-col;
	text-color: @fg-col;
}

mode-switcher {
	spacing: 8px;
	padding: 8px;
}

button {
	padding: 12px 16px;
	background-color: @bg-col-light;
	text-color: @fg-col2;
	vertical-align: 0.5;
	horizontal-align: 0.5;
	border-radius: 12px;
	border: 2px;
	border-color: transparent;
}

button selected {
	background-color: @accent;
	text-color: @primary-container-fg;
	border-color: @blue;
}

message {
	background-color: @bg-col-light;
	margin: 8px;
	padding: 12px;
	border-radius: 12px;
	border: 2px;
	border-color: @border-col;
}

textbox {
	text-color: @fg-col;
	padding: 4px;
}
